{
  "source": {
    "type": "AzureDevOps",
    "organization": "$(ADO_ORG)",
    "project": "$(ADO_PROJECT)",
    "pat": "$(ADO_PAT)"
  },
  "target": {
    "organization": "First-Devops-organisation",
    "pat": "$(GH_PAT)"
  },
  "migration": {
    "cloneTempDir": "./tmp/clones",
    "singleRepo": "ADO_To_GHAS_Migration",
    "targetRepoVisibility": "private",
    "lockSourceRepo": false,
    "retryCount": 3,
    "retryDelaySeconds": 30
  },
  "batches": [
    {
      "name": "batch-1-pilot",
      "scheduledDate": "2026-04-15",
      "repos": [
        "ADO_To_GHAS_Migration",
        "APIOPS-poc",
        "dummy-secret",
        "hellogit",
        "hellogitworld.git",
        "migration"
      ]
    }
  ],
  "exclusions": {
    "repos": [],
    "branches": [],
    "repoBranches": {
      "APIOPS-poc": [
        "main"
      ],
      "ADO_To_GHAS_Migration": [
        "ankit-*"
      ],
      "hellogit": [
        "fbmaster"
      ]
    }
  },
  "output": {
    "reportDir": "./output/reports",
    "logDir": "./output/logs"
  }
}