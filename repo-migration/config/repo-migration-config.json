
{
  "source": {
    "type": "AzureDevOps",
    "organization": "$(ADO_Org)",
    "project": "$(ADO_Project)",
    "pat": "$(ADO_PAT)"
  },
  "target": {
    "organization": "$(GitHub_Org)",
    "pat": "$(GH_PAT)"
  },
  "migration": {
    "cloneTempDir": "$(CLONE_TEMP_DIR)",
    "targetRepoVisibility": "private",
    "lockSourceRepo": false,
    "retryCount": 3,
    "retryDelaySeconds": 30
  },
  "batches": [
    {
      "name": "batch-1-pilot",
      "scheduledDate": "2026-04-15",
      "repos": [
        "migration_testing",
         "CICD-ADO-Azure"
        
      ]
    }
  ],
  "exclusions": {
    "repos": [
      "old-archived-repo",
      "test-throwaway-repo"
    ],
    "branches": []
  },
  "output": {
    "reportDir": "$(REPORT_DIR)",
    "logDir": "$(LOG_DIR)"
  }
}


