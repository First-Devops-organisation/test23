
{
  "source": {
    "type": "AzureDevOps",
    "organization": "$(ADO_ORG)",
    "project": "$(ADO_PROJECT)",
    "pat": "$(ADO_PAT)"
  },
  "target": {
    "organization": "$(GH_ORG)",
    "pat": "$(GH_PAT)"
  },
  "migration": {
    "cloneTempDir": "./tmp/clones",
    "singleRepo": { "source": "dashboard-testing", "target": "dashboard-testing-renamed1" },
    "targetRepoVisibility": "private",
    "lockSourceRepo": false,
    "retryCount": 3,
    "retryDelaySeconds": 30
  },
  "batches": [
    {
      "name": "batch-1-pilot",
      "scheduledDate": "2026-04-15",
      "repos": [
        "Advanced-Security",
        { "source": "Demoapp-Application-API", "target": "Demoapp-Application-API-renamed" },
        { "source": "SSPM", "target": "" },
        { "source": "ADO-githubcopilot-repo" }
      ]
    }
  ],
  "exclusions": {
    "repos": [],
    "branches": []
  },
  "output": {
    "reportDir": "./output/reports",
    "logDir": "./output/logs"
  }
}
