{
  "source": {
    "type": "AzureDevOps",
    "organization": "https://dev.azure.com/YOUR_ADO_ORG",
    "project": "YOUR_ADO_PROJECT",
    "pat": "$(ADO_PAT)"
  },
  "target": {
    "type": "GitHubEnterpriseCloud",
    "organization": "YOUR_GITHUB_ORG",
    "pat": "$(GH_PAT)"
  },
  "migration": {
    "includeTeams": true,
    "lockSourceRepo": true,
    "targetRepoVisibility": "internal",
    "queuedBehavior": "import",
    "skipReleases": false,
    "batchSize": 10,
    "retryCount": 3,
    "retryDelaySeconds": 30,
    "cloneTempDir": "./tmp/clones"
  },
  "batches": [
    {
      "name": "batch-1-pilot",
      "repos": ["repo-alpha", "repo-beta", "repo-gamma"],
      "scheduledDate": "2026-04-15"
    },
    {
      "name": "batch-2",
      "repos": ["repo-delta", "repo-epsilon"],
      "scheduledDate": "2026-04-22"
    }
  ],
  "exclusions": {
    "repos": ["archived-legacy-repo", "temp-throwaway"],
    "branches": []
  },
  "output": {
    "reportDir": "./reports",
    "logDir": "./logs"
  }
}
