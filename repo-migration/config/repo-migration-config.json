{
  "source": {
    "type": "AzureDevOps",
    "organization": "$(ADO_ORG)",
    "project": "$(ADO_PROJECT)",
    "pat": "$(ADO_PAT)"
  },
  "target": {
    "organization": "First-Devops-organisation",
    "pat": "$(GH_PAT)"
  },
  "migration": {
    "cloneTempDir": "./tmp/clones",
    "singleRepo": "Azure-DevOpstemplate",
    "targetRepoVisibility": "private",
    "lockSourceRepo": false,
    "retryCount": 3,
    "retryDelaySeconds": 30
  },
  "batches": [
    {
      "name": "batch-1-pilot",
      "scheduledDate": "2026-04-15",
      "repos": [
        "Azure-DevOpstemplate",
        "trivy-ci-test"
      ]
    }
  ],
  "exclusions": {
    "repos": [],
    "branches": [
      "tag/*"
    ]
  },
  "output": {
    "reportDir": "./output/reports",
    "logDir": "./output/logs"
  }
}