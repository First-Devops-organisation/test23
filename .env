# Azure DevOps credentials
ADO_ORG=XXXXXXX
ADO_PROJECT=XXXXXXX
ADO_PAT=XXXXXXX

# GitHub credentials
GITHUB_TOKEN=XXXXXXX
GITHUB_OWNER=XXXXXXX
GITHUB_REPO=XXXXXXX
GITHUB_ORG=XXXXXXX

# NEW: tell the script whether GITHUB_ORG is an org or a personal account.
# This skips the auto-detection entirely and avoids the GraphQL error.
#
#   GITHUB_OWNER_TYPE=org    ← use this if GITHUB_ORG is an organisation
#   GITHUB_OWNER_TYPE=user   ← use this if GITHUB_ORG is a personal account
#
# If you leave this blank the script auto-detects (tries org first, then user).
GITHUB_OWNER_TYPE=org