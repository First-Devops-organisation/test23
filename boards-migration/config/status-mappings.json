{
  "_comment": "Maps ADO work item states to GitHub ProjectV2 Status column values. Supports per-type overrides. GitHub status values MUST match your ProjectV2 Status field options exactly (case-sensitive).",
  "defaultMapping": {
    "New": "Backlog",
    "Active": "In progress",
    "Resolved": "Done",
    "Closed": "Done",
    "Done": "Done",
    "Removed": "Done"
  },
  "typeOverrides": {
    "Bug": {
      "New": "Backlog",
      "Active": "In progress",
      "Resolved": "Done",
      "Closed": "Done"
    },
    "Task": {
      "New": "Backlog",
      "Active": "In progress",
      "Closed": "Done"
    },
    "Epic": {
      "New": "Backlog",
      "Active": "In progress",
      "Resolved": "Done",
      "Closed": "Done"
    },
    "Feature": {
      "New": "Backlog",
      "Active": "In progress",
      "Resolved": "Done",
      "Closed": "Done"
    }
  },
  "closedStates": [
    "Done",
    "Closed",
    "Resolved",
    "Removed"
  ],
  "githubProjectStatusOptions": [
    "Backlog",
    "Ready",
    "In progress",
    "In review",
    "Done"
  ]
}