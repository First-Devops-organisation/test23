{
  "_comment": "Maps ADO work item states to GitHub ProjectV2 Status column values. When autoSyncStatuses is true, ADO states are auto-created in GitHub; defaultMapping acts as fallback only.",
  "autoSyncStatuses": true,
  "defaultMapping": {
    "New": "Backlog",
    "Active": "In progress",
    "Resolved": "Done",
    "Closed": "Done",
    "Done": "Done",
    "Removed": "Done"
  },
  "typeOverrides": {
    "Bug": {
      "New": "Backlog",
      "Active": "In progress",
      "Resolved": "Done",
      "Closed": "Done"
    },
    "Task": {
      "New": "Backlog",
      "Active": "In progress",
      "Closed": "Done"
    },
    "Epic": {
      "New": "Backlog",
      "Active": "In progress",
      "Resolved": "Done",
      "Closed": "Done"
    },
    "Feature": {
      "New": "Backlog",
      "Active": "In progress",
      "Resolved": "Done",
      "Closed": "Done"
    }
  },
  "closedStates": [
    "Done",
    "Closed",
    "Resolved",
    "Removed"
  ],
  "githubProjectStatusOptions": [
    "Backlog",
    "Ready",
    "In progress",
    "In review",
    "Done"
  ]
}