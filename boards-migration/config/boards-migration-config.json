{
  "source": {
    "type": "AzureDevOps",
    "organization": "YashTech-DevOps",
    "project": "YASH-DevOps-Serverless",
    "areaPath": "YASH-DevOps-Serverless\\POC-Migration",
    "pat": "$(ADO_PAT)"
  },
  "target": {
    "type": "GitHub",
    "organization": "Urvashi773",
    "repository": "ado-migration-poc",
    "projectNumber": 2,
    "projectOwner": "Urvashi773",
    "projectOwnerType": "user",
    "pat": "$(GH_PAT)"
  },
  "migration": {
    "migrateClosedWorkItems": true,
    "productionRun": true,
    "updateAssignedTo": true,
    "addAdoComments": true,
    "migrateAttachments": true,
    "migrateLinks": true,
    "migrateHistory": false,
    "preserveParentChild": true,
    "dryRun": false,
    "batchSize": 50,
    "rateLimitDelayMs": 1000,
    "retryCount": 3,
    "retryDelaySeconds": 10,
    "inviteCollaborators": false
  },
  "filters": {
    "workItemTypes": [
      "Epic",
      "Feature",
      "User Story",
      "Task",
      "Bug",
      "Issue",
      "Impediment",
      "Test Plan",
      "Test Suite",
      "Test Case"
    ],
    "excludeStates": [],
    "excludeTags": [],
    "workItemIds": []
  },
  "areaPathMapping": {
    "YASH-DevOps-Serverless\\POC-Migration": "area:poc-migration",
    "YASH-DevOps-Serverless\\POC-Migration\\ProjectAlpha": "area:project-alpha",
    "YASH-DevOps-Serverless\\POC-Migration\\ProjectBeta": "area:project-beta",
    "YASH-DevOps-Serverless\\POC-Migration\\ProjectGamma": "area:project-gamma"
  },
  "iterationPathMapping": {
    "YASH-DevOps-Serverless\\Sprint 1": "Sprint 1",
    "YASH-DevOps-Serverless\\Sprint 2": "Sprint 2",
    "YASH-DevOps-Serverless\\Sprint 3": "Sprint 3"
  },
  "priorityMapping": {
    "1": "priority:critical",
    "2": "priority:high",
    "3": "priority:medium",
    "4": "priority:low"
  },
  "severityMapping": {
    "1 - Critical": "severity:critical",
    "2 - High": "severity:high",
    "3 - Medium": "severity:medium",
    "4 - Low": "severity:low"
  },
  "customFields": {
    "_comment": "Controls which custom fields are created in GitHub ProjectV2. ADO Status preserves exact ADO state, Priority/Severity map ADO values to project fields.",
    "adoStatus": true,
    "priority": true,
    "severity": true,
    "storyPoints": true,
    "adoId": true
  },
  "output": {
    "reportDir": "./reports",
    "logDir": "./logs",
    "migrationLogFile": "./reports/migration-log.json"
  }
}