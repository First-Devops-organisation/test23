{
  "source": {
    "type": "AzureDevOps",
    "organization": "$(ADO_ORG)",
    "project": "$(ADO_PROJECT)",
    "pat": "$(ADO_PAT)"
  },
  "target": {
    "organization": "$(GH_ORG)",
    "pat": "$(GH_PAT)"
  },
  "pipelineMigration": {
    "pipelineIds": [],
    "mode": "dry-run"
  },
  "options": {
    "maxParallelMigrations": 5,
    "retryCount": 3,
    "retryDelaySeconds": 30,
    "dryRun": true,
    "logDirectory": "./logs",
    "repoVisibility": "internal",
    "enableGHAS": true,
    "scrubSecrets": true
  },
  "batches": [
    {
      "name": "batch-01-pilot",
      "adoProject": "ProjectA",
      "repos": ["repo1", "repo2", "repo3"],
      "migrationWindow": "2026-04-18T22:00:00Z",
      "teams": ["TeamA"],
      "priority": 1
    },
    {
      "name": "batch-02",
      "adoProject": "ProjectB",
      "repos": ["repo4", "repo5", "repo6", "repo7", "repo8"],
      "migrationWindow": "2026-04-25T22:00:00Z",
      "teams": ["TeamB"],
      "priority": 2
    }
  ],
  "PIPELINE_IDS": [1175,1150,1104],
  "PIPELINE_REPO_MAP": {"1175": "test1","1150":"test2","1104": "sample"},
  "PIPELINE_TYPE": "build",
  "MIGRATE_MODE": "migrate",
  "GH_REPO": "",
  "REUSABLE_PIPELINE_IDS": []
}
